{
  "version": 2,
  "buildCommand": "node scripts/build-frontend.mjs",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kathasangam-50046899580.development.catalystappsail.in/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://kathasangam-50046899580.development.catalystappsail.in/uploads/:path*"
    },
    {
      "source": "/story/:id",
      "destination": "https://kathasangam-50046899580.development.catalystappsail.in/story/:id"
    },
    {
      "source": "/story/:id/(.*)",
      "destination": "https://kathasangam-50046899580.development.catalystappsail.in/story/:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://kathasangam-50046899580.development.catalystappsail.in/sitemap.xml"
    },
    {
      "source": "/(google[a-zA-Z0-9]+\\.html)",
      "destination": "/$1"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/robots.txt",
      "destination": "https://kathasangam-50046899580.development.catalystappsail.in/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://*.kathasangam.co.in https://kathasangam.co.in https://*.catalystappsail.in https://*.catalyst.zoho.in https://*.catalystserverless.in; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.razorpay.com https://lumberjack.razorpay.com https://*.catalystappsail.in https://*.catalyst.zoho.in https://*.catalystserverless.in; frame-src 'self' https://api.razorpay.com; worker-src 'self' blob:; frame-ancestors 'none';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|woff|woff2|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
