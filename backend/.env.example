# Required by the API
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_JWT_SECRET=-----BEGIN PUBLIC KEY-----\nYOUR_ES256_PUBLIC_KEY\n-----END PUBLIC KEY-----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Search (recommended; the API logs failures without stopping the server)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=your-meilisearch-key

# Role configuration
ADMIN_EMAIL=admin@example.com
MODERATOR_EMAILS=moderator@example.com,another-moderator@example.com

# Optional runtime hardening
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.example
TRUSTED_PROXIES=203.0.113.10
LOG_FORMAT=json
