# Database & Supabase Configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
SUPABASE_JWT_SECRET="-----BEGIN PUBLIC KEY-----\nYOUR_ES256_PUBLIC_KEY\n-----END PUBLIC KEY-----"

# Role Configuration
ADMIN_EMAIL=admin@example.com
MODERATOR_EMAILS=moderator@example.com

# Optional CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay Configuration (UPI, Cards, NetBanking)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Creator Tipping Platform Fee Percentage (Default: 5)
PLATFORM_FEE_PERCENT=5

# Official Community & Social Media Channels
SOCIAL_NYBURS_URL=https://www.nyburs.com/home
SOCIAL_VYNC_URL=https://vync.live/
SOCIAL_TWITTER_URL=https://twitter.com/kathasangam
SOCIAL_GITHUB_URL=https://github.com/randommelo-lang/kathasangam
SUPPORT_EMAIL=contact@kathasangam.co.in
